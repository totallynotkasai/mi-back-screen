<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up to the cloud or moved to a new phone. The app's data includes Xiaomi's
    own back screen settings as they were before Quick Switch changed them, and any app lent to
    the back screen; restored on another phone, these would put back the wrong settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
